# Client .env for the AMD Developer Cloud endpoint (docs/operations/amd-instance.md).
# Copy to .env (gitignored) and fill the placeholders. Never commit a filled-in copy.
# GROQ_API_KEY keeps its meaning: your hosted Groq key. Keep it as it is.

# The vLLM server on the AMD instance (make llm-serve prints this line too)
GROQ_BASE_URL=http://<AMD_HOST_OR_IP>:8001/v1
# The token passed to vLLM as --api-key. Setting it makes GROQ_API_KEY the hosted backup behind the AMD host.
SELF_HOSTED_API_KEY=<AMD_VLLM_TOKEN>

# The instance serves one model (MODEL in vllm_serve.sh, default 20b). Both steps must name it, and the
# fallback step is off, so a second request does not ask for a model the server does not have.
# For 120b on a 192 GB MI300X: set MODEL=openai/gpt-oss-120b on the instance, then EXTRACT_MODEL=openai/gpt-oss-120b here.
# The hosted backup uses the same model name.
EXTRACT_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_ENABLED=false

# Shown in /api/health and the header tooltip. Set it to the hardware you actually rented, never a guess.
LLM_SERVING_LABEL="AMD Instinct MI300X, ROCm, vLLM"

# When the instance is stopped, empty GROQ_BASE_URL and SELF_HOSTED_API_KEY and restart the API. The chain then
# returns to the hosted Groq setup, or to rules only if GROQ_API_KEY is empty.
