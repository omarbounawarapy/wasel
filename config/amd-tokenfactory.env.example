# Client .env lines for AMD Token Factory, the API used by the AMD ACT III hackathon
# (docs/operations/amd-tokenfactory.md). Copy them into .env (gitignored). Never commit a filled-in copy.
# No GPU instance and no AMD Developer Cloud credit are needed for this path.

# From the user manual after sign-in at notebooks.amd.com/tokenfactory: the OpenAI-compatible base URL, ending in /v1
# (the app appends /chat/completions).
AMD_TOKENFACTORY_BASE_URL=<BASE_URL_FROM_THE_USER_MANUAL>
# The key redeemed on the Token Factory page.
AMD_TOKENFACTORY_API_KEY=<TOKEN_FACTORY_KEY>
# A model id exactly as the model catalogue writes it. The endpoint stays off until this is set.
AMD_TOKENFACTORY_MODEL=<MODEL_ID_FROM_THE_CATALOGUE>

# GROQ_API_KEY keeps its meaning. With it set, hosted Groq answers when Token Factory fails (path fallback_provider
# in the health payload and the eval report). Leave it empty to measure Token Factory alone.
