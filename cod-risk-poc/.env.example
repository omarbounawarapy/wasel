# cp .env.example .env and fill it in. The app, webhook.py and the scripts read cod-risk-poc/.env on start
# (a variable already set in the shell wins). On Streamlit Cloud, use the app's secrets as KEY = "value".
# Leave LLM_PROVIDER empty to run fully offline (keyword extractor + static templates).
# LLM_PROVIDER: groq or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (Meta). Leave WHATSAPP_TOKEN empty for mock sends (nothing leaves the app).
# From developers.facebook.com > your app > WhatsApp > API Setup:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The one number every message goes to (synthetic orders have no phones), with country code: +216 20 123 456.
# Must be in the test number's "To" list.
WHATSAPP_DEMO_TO=
# webhook.py only. App secret: App settings > Basic. Verify token: any string, typed again in the Meta dashboard.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_TEMPLATE=hello_world
# WHATSAPP_TEMPLATE_LANG=en_US
