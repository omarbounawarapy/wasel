# Docker build context for deploy/cloudflare/container/Dockerfile: deny everything, allow what the API reads at runtime.
*
!src/
!config/
!models/
!data/
!deploy/cloudflare/container/requirements.txt
!deploy/cloudflare/container/requirements.lock
# training / evaluation data the runtime never opens
data/synth_v1.csv
data/eval/
data/raw/
data/reports/raw/
**/__pycache__/
**/*.pyc
*.db
*.db-*
