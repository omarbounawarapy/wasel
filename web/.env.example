# Optional. Leave unset in normal use:
#   - the built app (web/dist, served by FastAPI) calls its own origin: /api
#   - `npm run dev` (:5173) calls http://localhost:8000 (the API must run with APP_MODE=dev for CORS)
# Set it only to point the UI at another API host, without the /api suffix.
# NEXT_PUBLIC_API_URL=https://your-wasel-host.example
