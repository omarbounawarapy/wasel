# ── Node modules ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Tests (not needed in production image) ───────────────────────────────────
__tests__/
coverage/
.nyc_output/
vitest.config.ts
playwright.config.*
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
e2e/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets / local env (never bake credentials into the image) ───────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Docker ───────────────────────────────────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Documentation / planning ─────────────────────────────────────────────────
*.md
docs/
architecture-plan/

