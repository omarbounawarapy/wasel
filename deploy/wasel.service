# systemd unit for a Linux host (docs/operations/deployment.md). Copy to /etc/systemd/system/wasel.service,
# adjust User and WorkingDirectory, then: sudo systemctl daemon-reload && sudo systemctl enable --now wasel
[Unit]
Description=Wasel (make serve: API + web UI on 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
User=wasel
WorkingDirectory=/opt/wasel
ExecStart=/usr/bin/make serve
Restart=always
RestartSec=3
# Sandboxing: the process can write only under var/ and gains no privileges. UMask makes the database and its
# -wal/-shm files owner-only. Run `systemd-analyze security wasel` after changing any of this.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/wasel/var
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0077
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
