# Local secrets for `wrangler dev` (copy to .dev.vars, which git ignores). Every line is optional:
# with none of them the container runs keyless (extraction falls back to rules; nothing is sent to WhatsApp).
# Deployed environments get the same names from `wrangler secret put <NAME> --env <preview|production>`.
GROQ_API_KEY=
GEMINI_API_KEY=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# >= 24 characters, or /api/admin is not mounted
ADMIN_TOKEN=
