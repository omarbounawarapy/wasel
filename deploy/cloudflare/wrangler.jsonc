{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "name": "wasel-dev",
  "vars": {
    "APP_MODE": "dev",
    "SEED_ON_BOOT": "if_empty",
    "DEMO_MODE": "true",
    "WORKER_ENABLED": "true",
    "LLM_MODE": "live",
    "DRAFT_LLM": "false",
    "WA_SEND_ENABLED": "false",
    "WA_AUTO_SEND": "false",
    "WEBHOOK_ENABLED": "false",
    "SNAPSHOT_URL": "http://state.wasel.internal/snapshot",
    "SNAPSHOT_INTERVAL_S": "60",
    "CLIENT_IP_HEADER": "CF-Connecting-IP",
    "CONTAINER_SLEEP_AFTER": "15m",
    "GIT_SHA": "dev"
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/webhook/*",
      "/docs",
      "/openapi.json"
    ],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WASEL",
        "class_name": "WaselContainer"
      }
    ]
  },
  "exports": {
    "WaselContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "containers": [
    {
      "class_name": "WaselContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "wasel-state-dev"
    }
  ],
  "env": {
    "preview": {
      "name": "wasel-preview",
      "vars": {
        "APP_MODE": "public",
        "SEED_ON_BOOT": "if_empty",
        "DEMO_MODE": "true",
        "WORKER_ENABLED": "true",
        "LLM_MODE": "live",
        "DRAFT_LLM": "false",
        "WA_SEND_ENABLED": "false",
        "WA_AUTO_SEND": "false",
        "WEBHOOK_ENABLED": "false",
        "SNAPSHOT_URL": "http://state.wasel.internal/snapshot",
        "SNAPSHOT_INTERVAL_S": "60",
        "CLIENT_IP_HEADER": "CF-Connecting-IP",
        "CONTAINER_SLEEP_AFTER": "15m",
        "GIT_SHA": "dev"
      },
      "assets": {
        "directory": "../../web/dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/api/*",
          "/webhook/*",
          "/docs",
          "/openapi.json"
        ],
        "not_found_handling": "404-page"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WASEL",
            "class_name": "WaselContainer"
          }
        ]
      },
      "exports": {
        "WaselContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "containers": [
        {
          "class_name": "WaselContainer",
          "image": "./container/Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "r2_buckets": [
        {
          "binding": "STATE",
          "bucket_name": "wasel-state-preview"
        }
      ]
    },
    "production": {
      "name": "wasel-production",
      "vars": {
        "APP_MODE": "public",
        "SEED_ON_BOOT": "if_empty",
        "DEMO_MODE": "true",
        "WORKER_ENABLED": "true",
        "LLM_MODE": "live",
        "DRAFT_LLM": "false",
        "WA_SEND_ENABLED": "false",
        "WA_AUTO_SEND": "false",
        "WEBHOOK_ENABLED": "false",
        "SNAPSHOT_URL": "http://state.wasel.internal/snapshot",
        "SNAPSHOT_INTERVAL_S": "60",
        "CLIENT_IP_HEADER": "CF-Connecting-IP",
        "CONTAINER_SLEEP_AFTER": "15m",
        "GIT_SHA": "dev"
      },
      "assets": {
        "directory": "../../web/dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/api/*",
          "/webhook/*",
          "/docs",
          "/openapi.json"
        ],
        "not_found_handling": "404-page"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WASEL",
            "class_name": "WaselContainer"
          }
        ]
      },
      "exports": {
        "WaselContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "containers": [
        {
          "class_name": "WaselContainer",
          "image": "./container/Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "r2_buckets": [
        {
          "binding": "STATE",
          "bucket_name": "wasel-state-production"
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  }
}
