# Copy the values into your shell (export ...) or into .streamlit/secrets.toml as KEY = "value".
# Leave LLM_PROVIDER empty to run fully offline (keyword extractor + static templates).
# LLM_PROVIDER: groq or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
