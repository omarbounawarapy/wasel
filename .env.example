# Every environment variable. Secrets stay empty here; set them on the host or in a local .env.
# ---- secrets (never committed)
GROQ_API_KEY=
GEMINI_API_KEY=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# ADMIN_TOKEN must be >= 24 chars; empty = /api/admin not mounted
ADMIN_TOKEN=
# ---- mode and safety (unset APP_MODE -> public)
APP_MODE=
WA_SEND_ENABLED=false
# auto_send drafts (cleared by the draft gate, high confidence, price cap, 24 h window) go out without a click
WA_AUTO_SEND=false
WEBHOOK_ENABLED=false
# auto | always | if_empty | never  (auto: public -> always, event/dev -> if_empty)
SEED_ON_BOOT=auto
DB_PATH=var/app.db
DEMO_MODE=true
WORKER_ENABLED=true
# ---- LLM (live | replay | fail_primary | fail_groq | fail_all)
LLM_MODE=live
# LLM_MODE=replay serves recorded provider responses (JSON envelopes) from this directory
# LLM_REPLAY_DIR=data/llm_replay
EXTRACT_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b
# Self-hosted OpenAI-compatible endpoint (vLLM on a GPU host; docs/operations/self-hosted-llm.md). Empty = Groq.
# When set, GROQ_API_KEY must still hold a value — the vLLM --api-key token — and the Groq-only
# reasoning_format field is dropped from requests automatically.
# Values containing spaces must be quoted (the .env loader is name-rewrite only), e.g.
#   VLLM_ARGS="--gpu-memory-utilization 0.92 --max-model-len 16384"
GROQ_BASE_URL=
# false if Groq rate buckets turn out to be per org (V3)
GROQ_FALLBACK_ENABLED=true
GEMINI_ENABLED=false
# a Flash-class model id from your Gemini account
GEMINI_MODEL=
PROBE_FILE=config/probe.json
LLM_DEADLINE_S=20
# Overrides the extract prompt version from config/llm.yaml; leave unset unless testing another version.
# It must be registered in config/llm.yaml and needs `make warm` first (the seed cache is keyed on the version)
# PROMPT_VERSION=
DRAFT_LLM=false
# ---- caps and sandbox (empty LIVE_LLM_DAILY_CAP -> mode default: public 80, event 300, dev unlimited)
LIVE_LLM_DAILY_CAP=
# Daily token guard per model (empty -> public 120000, other modes no guard)
LIVE_LLM_TOKENS_PER_MODEL_DAY=
VISITOR_LLM_CAP_10MIN=6
VISITOR_LLM_CAP_DAY=20
SANDBOX_TTL_S=7200
SANDBOX_MAX_ORDERS=15
PURGE_INTERVAL_S=600
# ---- WhatsApp non-secret
WA_PHONE_NUMBER_ID=
# only used by scripts/ops/wa_webhook_up.sh (make wa-up) to register the callback
META_APP_ID=
WA_API_VERSION=
# ---- hosting (make serve / make tunnel; docs/operations/deployment.md)
# 127.0.0.1 = only the Cloudflare tunnel on this machine reaches the app; 0.0.0.0 exposes the port on the network
HOST=127.0.0.1
# secret: Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install token
CLOUDFLARE_TUNNEL_TOKEN=
# ---- runtime
PORT=8000
GIT_SHA=dev
FRONTEND_ORIGIN=http://localhost:5173
# Host values the API accepts outside public mode; add your tunnel hostname when you publish it
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SCORING_CONFIG=config/scoring.yaml

# ---- Cloudflare Containers (docs/operations/cloudflare.md). On the container these come from wrangler.jsonc vars.
# file:///abs/path or http(s):// store the SQLite DB is restored from at boot and saved to while running. Empty = off
# (make serve / make run never need it). Ignored when SEED_ON_BOOT resolves to "always".
SNAPSHOT_URL=
SNAPSHOT_INTERVAL_S=60
