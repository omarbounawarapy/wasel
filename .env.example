# Every variable from 01 §7 / 04 §3.2. Secrets stay empty here; set them on the host or in a local .env.
# ---- secrets (never committed)
GROQ_API_KEY=
GEMINI_API_KEY=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# ADMIN_TOKEN must be >= 24 chars; empty = /api/admin not mounted
ADMIN_TOKEN=
# ---- mode and safety (unset APP_MODE -> public)
APP_MODE=
WA_SEND_ENABLED=false
# S-2: auto_send drafts (judge-approved, high confidence, price cap, 24 h window) go out without a click
WA_AUTO_SEND=false
WEBHOOK_ENABLED=false
# auto | always | if_empty | never  (auto: public -> always, event/dev -> if_empty)
SEED_ON_BOOT=auto
DB_PATH=var/app.db
DEMO_MODE=true
WORKER_ENABLED=true
DEBUG_RAW=false
# ---- LLM (live | replay | fail_primary | fail_groq | fail_all)
LLM_MODE=live
EXTRACT_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b
# false if Groq rate buckets turn out to be per org (V3)
GROQ_FALLBACK_ENABLED=true
GEMINI_ENABLED=false
# [VERIFY] free-tier Flash-class model id from the probe
GEMINI_MODEL=
PROBE_FILE=config/probe.json
LLM_DEADLINE_S=20
PROMPT_VERSION=extract-v1
DRAFT_LLM=false
CASCADE_ENABLED=false
# ---- caps and sandbox (empty LIVE_LLM_DAILY_CAP -> mode default: public 80, event 300, dev unlimited)
LIVE_LLM_DAILY_CAP=
VISITOR_LLM_CAP_10MIN=6
VISITOR_LLM_CAP_DAY=20
SANDBOX_TTL_S=7200
SANDBOX_MAX_ORDERS=15
PURGE_INTERVAL_S=600
# ---- WhatsApp non-secret
WA_PHONE_NUMBER_ID=
WA_API_VERSION=
# ---- runtime
PORT=8000
GIT_SHA=dev
FRONTEND_ORIGIN=http://localhost:5173
TZ_DISPLAY=Africa/Tunis
SCORING_CONFIG=scoring.yaml
